# Copy this file to .env and fill in real values locally.
# Never commit .env — it's already gitignored.

# --- Phase 2: database (Neon Postgres, EU region) ---
DATABASE_URL=

# --- Phase 3: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 4: admin auth ---
# Random long string used to sign admin session cookies (JWT).
SESSION_SECRET=

# Only used as inline args to the one-off admin-bootstrap script, never
# loaded from .env by the running app itself:
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx prisma/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Maintenance mode (src/proxy.ts) ---
# When "true", every public route except /admin and /api redirects to
# /maintenance. MAINTENANCE_BYPASS_SECRET lets us preview the real site via
# /?preview=<secret>, which sets a cookie bypassing the gate for that browser.
# Day to day, use the owner switch in Admin > Settings (stored in the DB, no
# redeploy). Leave MAINTENANCE_MODE empty, or it overrides that switch.
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_SECRET=

# --- Order confirmation emails (src/lib/mail.ts, Microsoft 365 Graph API) ---
# Sent from an Azure app registration with Mail.Send application permission,
# via the mailbox at MS365_SENDER_EMAIL. If any of these four are unset,
# sendOrderConfirmationEmail() no-ops (logs once, doesn't throw).
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER_EMAIL=
