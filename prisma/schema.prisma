// Weekly Table data model.
// See ~/.claude/plans/i-want-to-build-expressive-wall.md for the full design rationale.
//
// Deliberately absent by design (see the plan's "Explicitly out of scope"):
// no Customer/Account/Subscription tables, no per-dish price field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  cancelled
}

enum PaymentMethod {
  stripe
  cash
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum Category {
  classics
  italian
  bowls
  mexican
  indian
  asian
  global
}

enum DietaryTag {
  vegetarian
  gluten_free  @map("gluten-free")
  high_protein @map("high-protein")
}

// owner: full access, including admin-user management. kitchen: orders +
// upcoming-deliveries report + per-meal fulfillment, no menu/pricing/
// settings edits. delivery: read-only upcoming-deliveries report only.
enum AdminRole {
  owner
  kitchen
  delivery
}

model Dish {
  id          String      @id @default(uuid())
  name        String      @unique
  category    Category
  dietaryTag  DietaryTag?
  description String
  imageUrl    String
  isActive    Boolean     @default(true)

  // Which days of the week this dish can be delivered on — not every dish
  // is cooked every day. Defaults to every day so existing/new dishes stay
  // orderable unless an admin deliberately narrows this.
  availableDays Weekday[] @default([monday, tuesday, wednesday, thursday, friday, saturday, sunday])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton (id "default") for site-wide switches that must change without a
// deploy. maintenanceMode is read by src/proxy.ts; the MAINTENANCE_MODE env
// var can also force maintenance on.
model SiteSetting {
  id              String   @id @default("default")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Admin-uploaded dish photos. Netlify's runtime filesystem is read-only, so
// uploads live in Postgres and are served by /api/dish-images/[id]. Rows are
// never mutated — a replaced photo gets a new row (and so a new, immutable,
// forever-cacheable URL), and the old row is deleted.
model DishImage {
  id          String   @id @default(uuid())
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())
}

model Plan {
  id        String  @id @default(uuid())
  label     String
  mealCount Int
  priceGbp  Int // integer pence, never float
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // When true, mealCount is a MINIMUM rather than an exact count — the
  // customer can select more meals than mealCount, each extra one billed
  // at this plan's per-meal rate (priceGbp / mealCount). Lets one tier
  // ("5+ meals a week") cover any larger count instead of needing a
  // separate fixed-price tier for every possible size.
  allowExtraMeals Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Effectively a singleton row (query by a known id, e.g. "default").
model CutoffConfig {
  id         String   @id @default("default")
  leadDays   Int      @default(1)
  cutoffTime String // "HH:MM" 24h, interpreted in `timezone`
  timezone   String   @default("Europe/London")

  // The selectable delivery time-slot window (30-min increments in
  // between) — distinct from cutoffTime, which gates when ORDERS must be
  // placed by, not what hour a meal can be requested for.
  deliveryWindowStart String @default("16:00") // "HH:MM", 24h
  deliveryWindowEnd   String @default("22:00") // "HH:MM", 24h

  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(uuid())

  // No single deliveryDate here — each meal in the order can be delivered
  // on a different day (see OrderItem.deliveryDate). One order = one
  // payment/contact/address, potentially spanning several delivery days.

  planId               String
  plan                 Plan   @relation(fields: [planId], references: [id])
  planLabelSnapshot    String
  planPriceGbpSnapshot Int

  contactName  String
  contactPhone String
  contactEmail String
  addressLine1 String
  addressLine2 String?
  city         String
  postcode     String

  // Free-text, whole-order notes (e.g. dietary restrictions) captured once
  // at checkout — not per-meal.
  notes String?

  // Defaults to stripe so existing historical rows (all Stripe orders,
  // this being the first non-Stripe path) backfill correctly.
  paymentMethod PaymentMethod @default(stripe)

  status OrderStatus @default(pending_payment)

  // Nullable: cash orders never create a real Stripe Checkout Session.
  // Postgres allows multiple NULLs in a unique index, so this doesn't
  // collide across cash orders.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId           String
  dish             Dish   @relation(fields: [dishId], references: [id])
  dishNameSnapshot String

  // Which day this specific meal is delivered/picked up on.
  deliveryDate DateTime @db.Date

  // Requested delivery time slot ("HH:MM", 24h). Nullable because
  // historical orders (placed before this feature existed) never
  // captured one — always required for new orders via server-side
  // validation in POST /api/orders.
  deliveryTime String?

  // Independent of Order.status — no auto-sync either direction. An order
  // can have some meals fulfilled and others not yet.
  fulfilled Boolean @default(false)

  @@index([orderId])
  @@index([deliveryDate])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(owner)

  // Deactivated accounts can't log in (checked at login) and lose access
  // immediately even on an existing session (checked on every admin
  // request — see requireAdminSession). Never hard-deleted, so historical
  // actions still trace back to a named account.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}
